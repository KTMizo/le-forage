{
  "format": "page",
  "id": "legal_page",
  "json": {
    "Contenu": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Titre"
        },
        "type": "Text"
      },
      "subtitle": {
        "config": {
          "label": "Sous-titre"
        },
        "type": "Text"
      },
      "sections": {
        "config": {
          "fields": {
            "title": {
              "config": {
                "label": "Titre"
              },
              "type": "Text"
            },
            "content": {
              "config": {
                "allowTargetBlank": true,
                "label": "Contenu",
                "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item"
              },
              "type": "StructuredText"
            }
          },
          "label": "Sections"
        },
        "type": "Group"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Page légale",
  "repeatable": true,
  "status": true
}